    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.11"
