# NomadVNC account backend — copy to .env for local runs (never commit real
# values). Full guide: docs/self-hosting.md

PORT=3200
DATABASE_URL=postgres://nomad:nomad-dev@localhost:5432/nomadvnc
# 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-32-plus-random-bytes
JWT_EXPIRES_IN=24h
# Public address of this server (sign-in and account-deletion emails).
PUBLIC_APP_URL=http://localhost:3200
MAGIC_LINK_TTL_MINUTES=15

# Reverse-proxy hops to trust for client IPs (rate limiting). Set to 1
# behind Traefik/Caddy/nginx; leave empty when the port is exposed directly.
TRUST_PROXY=
CORS_ORIGIN=

# --- Mail (sign-in links + share invites) -------------------------------
# Pick ONE. Auto-detected: SMTP_HOST set → smtp; else POSTAL_API_KEY → postal.
# MAIL_TRANSPORT=smtp | postal | log | none   (explicit override)
#   log = print emails (incl. sign-in links) to stdout; single-user only.
MAIL_FROM=NomadVNC <signin@example.com>
MAIL_REPLY_TO=

# SMTP: your own mail server or any provider.
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465); false = STARTTLS when offered (587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Postal (self-hosted mail platform, HTTP API)
POSTAL_API_URL=
POSTAL_API_KEY=

# --- Credential sync / sharing encryption --------------------------------
# 32 random bytes as 64 hex chars (or base64). Without it, credential and
# sharing endpoints answer 503. BACK IT UP: losing it orphans every stored
# password.
DATA_KEY=
# Previous key during rotation (rows are re-encrypted to DATA_KEY on boot).
DATA_KEY_OLD=
