{
  "name": "nomadvnc",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "build": "turbo run build && pnpm build:go",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test && pnpm go:test",
    "typecheck": "turbo run typecheck",
    "desktop": "pnpm --filter @nomadvnc/desktop start",
    "desktop:dev": "pnpm --filter @nomadvnc/desktop dev:electron",
    "desktop:package:linux": "pnpm build:go && pnpm --filter @nomadvnc/desktop package:linux",
    "desktop:package:mac": "pnpm build:go && pnpm --filter @nomadvnc/desktop package:mac",
    "desktop:package:win": "pnpm build:go && pnpm --filter @nomadvnc/desktop package:win",
    "mobile": "pnpm --filter @nomadvnc/mobile start",
    "build:desktop": "pnpm --filter @nomadvnc/desktop build",
    "go:tidy": "cd go-core && go mod tidy",
    "go:test": "cd go-core && go test ./...",
    "build:go": "node scripts/build-go.mjs",
    "build:host": "node scripts/build-host.mjs",
    "bootstrap:dev": "pnpm install && pnpm go:tidy && pnpm build",
    "icons": "pnpm --filter @nomadvnc/desktop generate:icons"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "turbo": "^2.11.7",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ],
    "patchedDependencies": {
      "react-native-webview": "patches/react-native-webview.patch",
      "metro@0.82.5": "patches/metro@0.82.5.patch"
    },
    "overrides": {
      "@babel/core": "7.29.6",
      "@vitest/mocker": "4.1.11",
      "@xmldom/xmldom": "0.8.15",
      "app-builder-lib": "26.15.3",
      "axios": "1.20.0",
      "baseline-browser-mapping": "2.11.27",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "browserslist": "4.29.3",
      "builder-util-runtime": "9.7.0",
      "electron-builder-squirrel-windows": "26.15.3",
      "esbuild": "0.28.2",
      "fast-xml-parser": "5.11.2",
      "follow-redirects": "1.16.1",
      "form-data@4": "4.0.6",
      "http-cache-semantics": "4.3.0",
      "image-size": "2.0.4",
      "proxy-addr": "2.0.8",
      "ip-address": "10.7.3",
      "joi": "18.2.9",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "nanoid@3": "3.3.20",
      "postcss@8": "8.5.29",
      "qs": "6.16.0",
      "shell-quote": "1.12.0",
      "tar@7": "7.5.22",
      "tmp": "0.2.7",
      "ws@6": "6.2.6",
      "ws@7": "7.5.13",
      "ws@8": "8.22.0"
    }
  },
  "homepage": "https://github.com/grpace/NomadVNC",
  "repository": {
    "type": "git",
    "url": "https://github.com/grpace/NomadVNC.git"
  },
  "bugs": "https://github.com/grpace/NomadVNC/issues"
}
